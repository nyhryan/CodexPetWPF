<Window x:Class="CodexPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CodexPet.App"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        mc:Ignorable="d"
        Title="MainWindow" 
        WindowStyle="None" 
        SizeToContent="WidthAndHeight" 
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        StateChanged="Window_StateChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" Width="256">
        <StackPanel Orientation="Vertical">
            <Viewbox Width="256" Height="48"
                     Stretch="Uniform" StretchDirection="DownOnly">
                <local:OutlinedCaption Text="{Binding EventText}"
                                       FontFamily="Impact" FontSize="40" />
            </Viewbox>
            <Border Background="#E8E8E8" Width="256" Height="256">
                <Image Width="256" Height="256"
                    Stretch="Uniform"
                    x:Name="image_gif"
                    gif:AnimationBehavior.RepeatBehavior="Forever" />
            </Border>
        </StackPanel>
    </Border>

    <Window.ContextMenu>
        <ContextMenu>
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="ItemBorder" Background="Transparent" Padding="12,6">
                                    <DockPanel>
                                        <TextBlock x:Name="CheckMark" DockPanel.Dock="Right" Text="✓" Margin="12,0,0,0" Visibility="Collapsed" />
                                        <ContentPresenter ContentSource="Header" />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#E5E5E5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.ItemContainerStyle>
            <MenuItem Header="설정" Click="SettingsMenuItem_Click" />
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="항상 위에 표시" IsCheckable="True" Click="AlwaysOnTopMenuItem_Click" />
            <MenuItem Header="트레이로 숨기기" Click="MinimizeMenuItem_Click" />
            <MenuItem Header="종료" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
